{
  "manifest_version": 3,
  "name": "ChatGPT DOM Virtualizer",
  "version": "1.3.0",
  "description": "Improves performance of long ChatGPT conversations by virtualizing message DOM rendering.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Virtualizer"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fetchInterceptor.js"],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]
    }
  ]
}